<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testa TaskEngine.Desktop.ViewModels (Mvvm/ + OnboardingViewModel), não TaskEngine.Desktop
       diretamente: TaskEngine.Desktop é um SingleProject MAUI (TargetFrameworks único
       net10.0-windows10.0.19041.0) e referenciá-lo a partir de um projeto de teste xUnit comum
       falha no build (Microsoft.Maui.Resizetizer detecta "duplicate file names" ao tentar
       reprocessar os itens MauiIcon/MauiImage do app referenciado dentro do próprio build do
       projeto de teste - problema conhecido de MAUI SingleProject sendo referenciado por um
       projeto não-MAUI). OnboardingViewModel e a base de Mvvm/ não dependem de nada de
       Microsoft.Maui.*, então vivem em TaskEngine.Desktop.ViewModels (net10.0 puro, sem MAUI),
       o que evita o problema por completo e ainda deixa este projeto de teste com o mesmo
       TargetFramework simples dos demais em tests/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Frontend\TaskEngine.Desktop.ViewModels\TaskEngine.Desktop.ViewModels.csproj" />
  </ItemGroup>

  <!-- NavigationService (TaskEngine.Desktop.Navigation) has no Microsoft.Maui.* dependency of its
       own - it is only organizationally a Desktop-only file. Compiled directly into this test
       assembly (rather than referenced via a ProjectReference to TaskEngine.Desktop, which is a
       MAUI SingleProject and hits the same "duplicate file names" Resizetizer problem explained
       above) so NavigationServiceTests.cs can cover its real parameter-passing/guard-clause logic
       (issue #53) instead of only a hand-written fake. -->
  <ItemGroup>
    <Compile Include="..\..\src\Frontend\TaskEngine.Desktop\Navigation\NavigationService.cs" Link="Navigation\NavigationService.cs" />
  </ItemGroup>

</Project>
