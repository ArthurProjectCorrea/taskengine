<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- App desktop: apenas Windows. Adicione net10.0-maccatalyst se precisar suportar macOS. -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TaskEngine.Desktop</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>TaskEngine</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.arthurdevcorrea.taskengine</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Empacotamento MSIX com certificado autoassinado (uso pessoal/instalação local, sem
		     Microsoft Store nem certificado pago — ver comentário sobre PackageCertificateKeyFile
		     abaixo para como regenerar o certificado). -->
		<WindowsPackageType>MSIX</WindowsPackageType>

		<!-- Certificado autoassinado usado para assinar o pacote MSIX. O .pfx NÃO é versionado
		     (chave privada) — fica em Certs/ (ignorado no .gitignore) e precisa ser gerado
		     localmente antes do primeiro `dotnet publish -p:WindowsPackageType=MSIX`. Regenere com
		     (PowerShell, como Administrador):
		       $cert = New-SelfSignedCertificate -Type Custom -Subject "CN=Arthur de Paula Correa" `
		         -KeyUsage DigitalSignature -FriendlyName "TaskEngine Desktop (dev, autoassinado)" `
		         -CertStoreLocation "Cert:\CurrentUser\My" `
		         -TextExtension @("2.5.29.37={text}1.3.6.1.5.5.7.3.3", "2.5.29.19={text}Subject Type:End Entity")
		       Export-PfxCertificate -Cert $cert -FilePath "src\Frontend\TaskEngine.Desktop\Certs\TaskEngine.Desktop.pfx" -Password (New-Object System.Security.SecureString)
		     O Subject do certificado (CN=Arthur de Paula Correa) precisa bater exatamente com
		     Identity/@Publisher no Package.appxmanifest. Certificado sem senha (SecureString vazia)
		     para simplificar o build local — se preferir senha, defina PackageCertificatePassword
		     via variável de ambiente/parâmetro de build em vez de commitá-la aqui. -->
		<PackageCertificateKeyFile>Certs\TaskEngine.Desktop.pfx</PackageCertificateKeyFile>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Composition root (issue #20): primeira referência do frontend ao backend. Infrastructure
	     traz Application/Domain transitivamente, então essa única referência já dá acesso a todos
	     os ports (IProviderAuthenticator, ITaskProviderClient, ICredentialStore, IAppSettingsStore)
	     e suas implementações concretas para registro no DI em MauiProgram.cs. -->
	<ItemGroup>
		<ProjectReference Include="..\..\Backend\TaskEngine.Infrastructure\TaskEngine.Infrastructure.csproj" />
		<!-- Mvvm/ e ViewModels/ (OnboardingViewModel) vivem em um projeto irmão separado, não aqui
		     - ver comentário no .csproj dele para o motivo (testabilidade sem os problemas de
		     referenciar um projeto MAUI SingleProject a partir de um projeto de teste xUnit). -->
		<ProjectReference Include="..\TaskEngine.Desktop.ViewModels\TaskEngine.Desktop.ViewModels.csproj" />
	</ItemGroup>

	<!-- Necessário para NotifyIcon (ícone de bandeja): dá acesso a System.Windows.Forms/System.Drawing.
	     Framework nativo da Microsoft (Windows Desktop, já instalado na máquina) — não é pacote NuGet
	     de terceiros. Referenciado diretamente via FrameworkReference (em vez da propriedade
	     `UseWindowsForms`) porque essa propriedade ativa o SDK.WindowsDesktop por completo, que por sua
	     vez trata os .xaml deste projeto (inclusive o Platforms\Windows\App.xaml do WinUI) como
	     Page/ApplicationDefinition do WPF e tenta compilá-los com o markup compiler do WPF — entrando em
	     conflito irreconciliável com a compilação MauiXaml/WinUI. O FrameworkReference dá o mesmo acesso
	     a NotifyIcon sem acionar esse pipeline. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
	</ItemGroup>

</Project>
