<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TaskEngine.Desktop.ViewModels"
             xmlns:converters="clr-namespace:TaskEngine.Desktop.Converters"
             x:Class="TaskEngine.Desktop.Views.MainShellPage"
             x:DataType="viewModels:ShellViewModel"
             Title="TaskEngine">

    <ContentPage.Resources>
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <!-- Estado padrão (não selecionado) dos botões de navegação da sidebar: transparente com
             ícone acinzentado, em vez de herdar o roxo Primary do Style global de Button - sem isso,
             os 3 botões ficavam permanentemente roxos e era impossível ver qual seção estava ativa
             (o DataTrigger de cada botão só define a cor do estado *ativo*; sem um Style local
             cobrindo o padrão, o padrão já "vencia" como roxo por conta do Style global). -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="56,*">

        <!-- Sidebar de navegação (issue #2): os 3 ícones do protótipo aprovado
             (Dashboard/Tarefas/Configurações) - ver docs/prototipo/*.dc.html. Glyphs reais via Segoe
             Fluent Icons (fonte nativa do Windows 11, sem asset/pacote adicional - item 4): antes
             mostrava as letras cruas "D"/"T"/"C" como placeholder nunca substituído. -->
        <VerticalStackLayout Grid.Column="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                             Spacing="8"
                             Padding="0,10"
                             VerticalOptions="Start"
                             HorizontalOptions="Center">

            <!-- Glifos Segoe Fluent Icons: E80F (Home/Dashboard), E9D2 (BulletedList/Tarefas), E713 (Setting/Configurações). -->
            <Button Text="&#xE80F;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="6"
                    Command="{Binding NavigateToDashboardCommand}"
                    SemanticProperties.Description="Dashboard">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding CurrentSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dashboard}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="&#xE9D2;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="6"
                    Command="{Binding NavigateToTarefasCommand}"
                    SemanticProperties.Description="Tarefas">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding CurrentSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Tarefas}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="&#xE713;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="6"
                    Command="{Binding NavigateToConfiguracoesCommand}"
                    SemanticProperties.Description="Configurações">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding CurrentSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Configuracoes}"
                                 Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </VerticalStackLayout>

        <!-- Área de conteúdo: MainShellPage.xaml.cs troca o Content deste host a cada navegação. -->
        <ContentView Grid.Column="1" x:Name="SectionHost" />

    </Grid>

</ContentPage>
