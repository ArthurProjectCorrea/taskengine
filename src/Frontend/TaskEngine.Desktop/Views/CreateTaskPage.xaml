<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TaskEngine.Desktop.ViewModels"
             xmlns:converters="clr-namespace:TaskEngine.Desktop.Converters"
             xmlns:views="clr-namespace:TaskEngine.Desktop.Views"
             x:Class="TaskEngine.Desktop.Views.CreateTaskPage"
             x:DataType="viewModels:CreateTaskViewModel"
             Title="Criar tarefa">

    <ContentPage.Resources>
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <converters:StringDateConverter x:Key="StringDateConverter" />

        <DataTemplate x:Key="TextFieldTemplate" x:DataType="viewModels:TaskFieldInputViewModel">
            <VerticalStackLayout Padding="0,6" Spacing="4">
                <Label Text="{Binding Label}" FontAttributes="Bold" />
                <Entry Text="{Binding Value}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="NumberFieldTemplate" x:DataType="viewModels:TaskFieldInputViewModel">
            <VerticalStackLayout Padding="0,6" Spacing="4">
                <Label Text="{Binding Label}" FontAttributes="Bold" />
                <Entry Text="{Binding Value}" Keyboard="Numeric" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="DateFieldTemplate" x:DataType="viewModels:TaskFieldInputViewModel">
            <VerticalStackLayout Padding="0,6" Spacing="4">
                <Label Text="{Binding Label}" FontAttributes="Bold" />
                <DatePicker Date="{Binding Value, Converter={StaticResource StringDateConverter}}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="SingleSelectFieldTemplate" x:DataType="viewModels:TaskFieldInputViewModel">
            <VerticalStackLayout Padding="0,6" Spacing="4">
                <Label Text="{Binding Label}" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Options}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedOption}" />
            </VerticalStackLayout>
        </DataTemplate>

        <views:TaskFieldTemplateSelector x:Key="FieldTemplateSelector"
            TextTemplate="{StaticResource TextFieldTemplate}"
            NumberTemplate="{StaticResource NumberFieldTemplate}"
            DateTemplate="{StaticResource DateFieldTemplate}"
            SingleSelectTemplate="{StaticResource SingleSelectFieldTemplate}" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label
                Text="Criar tarefa"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Preencha o título e, se quiser, a descrição. Os campos abaixo vêm do provedor conectado."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Título" FontAttributes="Bold" />
            <Entry Text="{Binding Title}" Placeholder="Título da tarefa" />

            <Label Text="Descrição" FontAttributes="Bold" />
            <Editor Text="{Binding Description}" Placeholder="Descrição (opcional)" HeightRequest="100" AutoSize="TextChanges" />

            <ActivityIndicator
                IsRunning="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LoadingSchema}"
                IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LoadingSchema}" />

            <Label
                Text="Carregando campos do provedor..."
                IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LoadingSchema}"
                TextColor="{StaticResource Gray500}" />

            <CollectionView ItemsSource="{Binding Fields}"
                             ItemTemplate="{StaticResource FieldTemplateSelector}"
                             SelectionMode="None" />

            <Button
                Text="Criar tarefa"
                Command="{Binding SubmitCommand}" />

            <ActivityIndicator
                IsRunning="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Submitting}"
                IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Submitting}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}"
                TextColor="Red" />

            <Label
                Text="Tarefa criada com sucesso."
                IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Success}"
                TextColor="Green" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
