<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TaskEngine.Desktop.ViewModels"
             xmlns:converters="clr-namespace:TaskEngine.Desktop.Converters"
             x:Class="TaskEngine.Desktop.Views.OnboardingPage"
             x:DataType="viewModels:OnboardingViewModel"
             Title="Conectar provedor">

    <ContentPage.Resources>
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    </ContentPage.Resources>

    <!-- Janela normal redimensionável (não mais a barra flutuante 700x80 do design antigo - ver
         MainWindowManager): o conteúdo fica centralizado numa coluna de largura confortável para
         leitura, com scroll de sobra para janelas menores, em vez de esticar por toda a largura. -->
    <ScrollView>
        <Grid Padding="40" RowDefinitions="Auto">
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="28"
                                 MaximumWidthRequest="640"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Conecte um provedor de tarefas"
                        Style="{StaticResource Headline}"
                        FontSize="28"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="O TaskEngine puxa suas tarefas de um provedor conectado - escolha um abaixo para autenticar e continuar."
                        Style="{StaticResource SubHeadline}"
                        FontSize="15"
                        FontAttributes="None"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding Providers}"
                                 SelectionMode="None"
                                 BindingContext="{Binding}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ProviderOption">
                            <Border StrokeShape="RoundRectangle 10"
                                    Padding="16,14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            StrokeShape="RoundRectangle 18"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}"
                                               TextColor="{StaticResource White}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center" />
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           VerticalOptions="Center"
                                           FontSize="16"
                                           FontAttributes="Bold" />

                                    <Button
                                        Grid.Column="2"
                                        Text="Conectar"
                                        Padding="14,8"
                                        VerticalOptions="Center"
                                        BindingContext="{Binding}"
                                        Command="{Binding BindingContext.ConnectCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding ProviderId}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Indicador de carregamento durante a autenticação com o provedor. -->
                <Border StrokeShape="RoundRectangle 10"
                        Padding="16,14"
                        IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Connecting}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="True" />
                        <Label Text="Conectando..."
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Mensagem de erro caso a conexão falhe. -->
                <Border StrokeShape="RoundRectangle 10"
                        Padding="16,14"
                        IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}"
                        Stroke="#C42B1C"
                        BackgroundColor="#FDF3F4">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="A conexão não foi concluída"
                               FontAttributes="Bold"
                               TextColor="#C42B1C" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C42B1C" />
                    </VerticalStackLayout>
                </Border>

                <!-- Confirmação de sucesso. -->
                <Border StrokeShape="RoundRectangle 10"
                        Padding="16,14"
                        IsVisible="{Binding State, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Connected}"
                        Stroke="#0F7B0F"
                        BackgroundColor="#F1FAF1">
                    <Label
                        Text="{Binding ConnectedProviderId, StringFormat='Provedor &quot;{0}&quot; conectado com sucesso.'}"
                        FontAttributes="Bold"
                        TextColor="#0F7B0F" />
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
